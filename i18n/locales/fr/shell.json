    "by": "ai",
    "reviewed": false
  },
  "shell.aiSetup.claude2": {
    "text": "Nommez-le Tiledash et collez l’adresse ci-dessous.",
    "source": "13f65c0cac",
    "by": "ai",
    "reviewed": false
  },
  "shell.aiSetup.claude3": {
    "text": "Choisissez Connecter : Tiledash vous demande de vous connecter avec votre compte Homey et d’autoriser l’accès.",
