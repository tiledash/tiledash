    "by": "ai",
    "reviewed": false
  },
  "shell.aiSetup.chatgpt2": {
    "text": "Choisissez Créer, nommez-le Tiledash, collez l’adresse ci-dessous et choisissez OAuth (laissez l’ID client et le secret vides).",
    "source": "10595a399d",
    "by": "ai",
    "reviewed": false
  },
  "shell.aiSetup.chatgpt3": {
    "text": "Connectez-vous avec votre compte Homey et autorisez l’accès.",
